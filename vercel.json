{
  "crons": [
    { "path": "/api/cron/dispatch-sync", "schedule": "* * * * *" },
    { "path": "/api/cron/sign-pack", "schedule": "* * * * *" }
  ],
  "rewrites": [
    { "source": "/invoice/:token", "destination": "/invoice.html" },
    { "source": "/my-jobs", "destination": "/api/public/my-jobs" },
    { "source": "/job-update", "destination": "/api/public/job-update" },
    { "source": "/sign", "destination": "/api/public/sign" },
    { "source": "/doc", "destination": "/api/public/doc" },
    { "source": "/pack", "destination": "/api/public/pack" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://unpkg.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://gyfuaynrqpfpdexbwyxs.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
